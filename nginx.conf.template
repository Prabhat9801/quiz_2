server {
    listen ${PORT};
    server_name _;
    # Never build absolute redirects: Render's internal PORT would leak into the Location header.
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback - client-side routes (react-router) all resolve to index.html.
    # index.html must never be cached, otherwise browsers keep referencing old,
    # content-hashed JS/CSS bundle filenames after a new deploy.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Question bank (public/tests/*.json). Short cache so a new deploy is picked up quickly.
    location /tests/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
}
